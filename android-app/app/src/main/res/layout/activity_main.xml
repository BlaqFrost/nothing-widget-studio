<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F6"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EAEAEA"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/nothing_red"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTHING PHONE (1) // WIDGET STUDIO"
                android:textColor="#0A0A0B"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TRANSPARENT WIDGETS"
            android:textColor="#0A0A0B"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Clear Glass • 2x2 Cover &amp; 4x2 Typebase Layouts"
            android:textColor="#56565F"
            android:textSize="13sp" />

        <!-- Spotify Integration Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/widget_glass_light_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ SPOTIFY // PKCE OAUTH ]"
                android:textColor="@color/nothing_red"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_spotify_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="READY TO CONNECT"
                android:textColor="#0A0A0B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <ProgressBar
                android:id="@+id/auth_status_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_connect_spotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#000000"
                android:text="CONNECT SPOTIFY"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_refresh_widgets"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SYNC ALL WIDGETS NOW"
                android:textColor="#0A0A0B"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Preview Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="[ 2×2 &amp; 4×2 WIDGETS ACTIVE ]"
            android:textColor="@color/nothing_red"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_glass_light_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/preview_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[♥ LIKED RECENT]"
                android:textColor="@color/nothing_red"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="CONNECT SPOTIFY TO PREVIEW"
                android:textColor="#0A0A0B"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/preview_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Waiting for liked song sync..."
                android:textColor="#56565F"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
